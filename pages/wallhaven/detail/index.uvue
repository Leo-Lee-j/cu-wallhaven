<template>
	<cl-page>
		<!-- 顶部导航栏 -->
		<cl-topbar
			fixed
			safe-area-top
			:show-back="true"
			background-color="transparent"
			:pt="{
				className: '!z-50',
				back: {
					className: 'text-white bg-black/30 rounded-full ml-2'
				}
			}"
		>
			<template #append>
				<view
					class="h-9 w-9 rounded-full flex flex-row items-center justify-center bg-black/30 mr-2"
					@tap="toggleFavorite"
				>
					<cl-icon
						:name="isFavorite ? 'heart-fill' : 'heart-line'"
						:color="isFavorite ? '#ef4444' : 'white'"
						:size="40"
					></cl-icon>
				</view>
			</template>
		</cl-topbar>

		<!-- 壁纸显示区域 -->
		<view class="wallpaper-container" v-if="wallpaper">
			<image
				:src="wallpaper?.getString('path') ?? ''"
				mode="aspectFit"
				class="w-full h-full"
				@tap="toggleFullscreen"
				:show-menu-by-longpress="true"
			></image>
		</view>

		<!-- 加载中 -->
		<view class="wallpaper-container flex flex-col items-center justify-center" v-else>
			<cl-loading :size="80" color="white"></cl-loading>
			<cl-text :pt="{ className: 'text-white/70 mt-4' }">加载中...</cl-text>
		</view>

		<!-- 底部操作栏 - 毛玻璃效果 -->
		<view class="detail-footer" v-if="!isFullscreen">
			<!-- 折叠详情区域（可滚动） -->
			<scroll-view
				scroll-y
				class="detail-content"
				:class="{ 'is-expanded': detailVisible && wallpaper != null }"
				v-if="wallpaper"
			>
				<view class="px-4 pt-4">
					<cl-list>
						<cl-list-item label="分辨率">
							<cl-text>{{ wallpaper?.getString('resolution') ?? '' }}</cl-text>
						</cl-list-item>
						<cl-list-item label="分类">
							<cl-tag size="small">{{ getCategoryLabel(wallpaper?.getString('category') ?? '') }}</cl-tag>
						</cl-list-item>
						<cl-list-item label="内容分级">
							<cl-tag
								size="small"
								:type="getPurityType(wallpaper?.getString('purity') ?? '')"
							>{{ getPurityLabel(wallpaper?.getString('purity') ?? '') }}</cl-tag>
						</cl-list-item>
						<cl-list-item label="浏览量">
							<cl-text>{{ wallpaper?.getNumber('views') ?? 0 }}</cl-text>
						</cl-list-item>
						<cl-list-item label="收藏数">
							<cl-text>{{ wallpaper?.getNumber('favorites') ?? 0 }}</cl-text>
						</cl-list-item>
						<cl-list-item label="文件大小">
							<cl-text>{{ formatFileSize(wallpaper?.getNumber('file_size') ?? 0) }}</cl-text>
						</cl-list-item>
						<cl-list-item label="文件类型">
							<cl-text>{{ wallpaper?.getString('file_type') ?? '' }}</cl-text>
						</cl-list-item>
						<cl-list-item v-if="wallpaper?.['uploader']" label="上传者">
							<cl-text>{{ (wallpaper?.['uploader'] as UTSJSONObject)?.getString('username') ?? '' }}</cl-text>
						</cl-list-item>
						<cl-list-item label="上传时间">
							<cl-text>{{ wallpaper?.getString('created_at') ?? '' }}</cl-text>
						</cl-list-item>
					</cl-list>

					<!-- 标签 -->
					<view class="mt-3" v-if="wallpaper?.['tags'] != null && ((wallpaper?.['tags'] as any[])?.length ?? 0) > 0">
						<cl-text :pt="{ className: 'text-sm text-white/60 mb-2' }">标签</cl-text>
						<view class="flex flex-row flex-wrap">
							<cl-tag
								v-for="tag in (wallpaper?.['tags'] as any[])"
								:key="(tag as UTSJSONObject).getNumber('id') ?? 0"
								size="small"
								:pt="{ className: 'mr-2 mb-2' }"
							>{{ (tag as UTSJSONObject).getString('name') ?? '' }}</cl-tag>
						</view>
					</view>

					<!-- 颜色 -->
					<view class="mt-3 pb-2" v-if="wallpaper?.['colors'] != null && ((wallpaper?.['colors'] as string[])?.length ?? 0) > 0">
						<cl-text :pt="{ className: 'text-sm text-white/60 mb-2' }">主要颜色</cl-text>
						<view class="flex flex-row flex-wrap">
							<view
								v-for="(color, index) in (wallpaper?.['colors'] as string[])"
								:key="index"
								class="w-8 h-8 rounded-lg mr-2 mb-2 border border-white/20"
								:style="{ backgroundColor: color }"
							></view>
						</view>
					</view>
				</view>
			</scroll-view>

			<!-- 操作按钮（始终可见） -->
			<view class="flex flex-row p-4 gap-3">
				<view
					class="flex-1 h-[88rpx] rounded-xl bg-white/20 flex flex-row items-center justify-center"
					@tap="downloadWallpaper"
				>
					<cl-loading v-if="downloading" :size="32" color="white"></cl-loading>
					<template v-else>
						<cl-icon name="download-line" :size="36" color="white"></cl-icon>
						<cl-text :pt="{ className: 'text-white ml-2' }">下载</cl-text>
					</template>
				</view>
				<view
					class="flex-1 h-[88rpx] rounded-xl bg-white/20 flex flex-row items-center justify-center"
					@tap="toggleDetail"
				>
					<cl-icon :name="detailVisible ? 'arrow-down-s-line' : 'arrow-up-s-line'" :size="36" color="white"></cl-icon>
					<cl-text :pt="{ className: 'text-white ml-2' }">{{ detailVisible ? '收起' : '详情' }}</cl-text>
				</view>
			</view>

			<cl-safe-area type="bottom"></cl-safe-area>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { ref, computed, onMounted } from "vue";
import { useStore } from "@/cool";
import { useUi } from "@/uni_modules/cool-ui";
import type { Wallpaper } from "@/types/wallhaven";

const ui = useUi();
const { wallhaven } = useStore();

// 壁纸数据
const wallpaper = ref<UTSJSONObject | null>(null);

// 壁纸ID
const wallpaperId = ref("");

// 详情折叠状态
const detailVisible = ref(false);

// 全屏模式
const isFullscreen = ref(false);

// 下载中
const downloading = ref(false);

// 是否已收藏
const isFavorite = computed(() => {
	return wallhaven.isFavorite(wallpaperId.value);
});

// 切换详情显示
function toggleDetail() {
	detailVisible.value = !detailVisible.value;
}

// 切换全屏
function toggleFullscreen() {
	isFullscreen.value = !isFullscreen.value;
}

// 切换收藏
function toggleFavorite() {
	if (isFavorite.value) {
		wallhaven.removeFavorite(wallpaperId.value);
		ui.showToast({ message: "已取消收藏" });
	} else {
		wallhaven.addFavorite(wallpaperId.value);
		ui.showToast({ message: "已收藏", icon: "heart-fill" });
	}
}

// 定义下载错误类型
type DownloadError = {
	errMsg: string
}

// 下载壁纸
async function downloadWallpaper() {
	if (wallpaper.value === null) return;

	downloading.value = true;

	try {
		// 下载图片
		const tempFilePath = await new Promise<string>((resolve, reject) => {
			uni.downloadFile({
				url: wallpaper.value?.getString('path') ?? '',
				success: (res) => {
					// 直接访问res对象的属性，无需类型转换
					resolve(res.tempFilePath);
				},
				fail: (err) => reject(err)
			});
		});

		// 保存到相册
		await new Promise<void>((resolve, reject) => {
			uni.saveImageToPhotosAlbum({
				filePath: tempFilePath,
				success: () => resolve(),
				fail: reject
			});
		});

		ui.showToast({
			message: "已保存到相册",
			icon: "check-line"
		});
	} catch (err: any) {
		const error = err as DownloadError
		ui.showToast({
			message: error.errMsg ?? "下载失败"
		});
	} finally {
		downloading.value = false;
	}
}

// 获取分类标签
function getCategoryLabel(category: string): string {
	switch (category) {
		case "general":
			return "综合";
		case "anime":
			return "动漫";
		case "people":
			return "人物";
		default:
			return category;
	}
}

// 获取纯度标签
function getPurityLabel(purity: string): string {
	switch (purity) {
		case "sfw":
			return "安全";
		case "sketchy":
			return "轻微";
		case "nsfw":
			return "成人";
		default:
			return purity;
	}
}

// 获取纯度类型（用于标签颜色）
function getPurityType(purity: string): any {
	switch (purity) {
		case "sfw":
			return "success";
		case "sketchy":
			return "warning";
		case "nsfw":
			return "error";
		default:
			return "info";
	}
}

// 格式化文件大小
function formatFileSize(bytes: number): string {
	if (bytes < 1024) return bytes + " B";
	if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
	return (bytes / (1024 * 1024)).toFixed(1) + " MB";
}

// 加载壁纸详情
async function loadWallpaper() {
	try {
		const result = await wallhaven.getWallpaper(wallpaperId.value);
		wallpaper.value = result as UTSJSONObject;
	} catch (err: any) {
		ui.showToast({
			message: err.message ?? "加载失败"
		});
	}
}

// 页面加载
onLoad((options?: UTSJSONObject) => {
	if (options == null) return;
	const id = options?.["id"] as string | null;
	if (id != null && id !== '') {
		wallpaperId.value = id;
		loadWallpaper();
	}
});
</script>

<style lang="scss" scoped>
.wallpaper-container {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: #000;
	display: flex;
	align-items: center;
	justify-content: center;
}

.detail-footer {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 40;
	background: rgba(0, 0, 0, 0.85);
	backdrop-filter: blur(20px);
	-webkit-backdrop-filter: blur(20px);
	border-radius: 32rpx 32rpx 0 0;
	max-height: 500px;
	display: flex;
	flex-direction: column;

	// 详情列表项白色文字
	:deep(.cl-list-item__label) {
		color: rgba(255, 255, 255, 0.6) !important;
	}

	:deep(.cl-text) {
		color: white !important;
	}

	:deep(.cl-list-item__wrapper) {
		background: transparent !important;
	}

	:deep(.cl-tag) {
		color: white !important;
	}
}

.detail-content {
	max-height: 0;
	opacity: 0;
	overflow: hidden;
	transition: max-height 0.3s ease-out, opacity 0.3s ease-out;

	&.is-expanded {
		max-height: 400px;
		opacity: 1;
	}
}
</style>
