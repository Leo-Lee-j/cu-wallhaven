<template>
	<cl-page>
		<!-- 顶部导航栏 -->
		<cl-topbar
			fixed
			safe-area-top
			:show-back="true"
			background-color="transparent"
			:pt="{
				className: '!z-50',
				back: {
					className: 'text-white bg-black/30 rounded-full ml-2'
				}
			}"
		>
			<template #append>
				<view
					class="h-9 w-9 rounded-full flex flex-row items-center justify-center bg-black/30 mr-2"
					@tap="toggleFavorite"
				>
					<cl-icon
						:name="isFavorite ? 'heart-fill' : 'heart-line'"
						:color="isFavorite ? '#ef4444' : 'white'"
						:size="40"
					></cl-icon>
				</view>
			</template>
		</cl-topbar>

		<!-- 壁纸显示区域 -->
		<view class="wallpaper-container" v-if="wallpaper">
			<image
				:src="wallpaper.path"
				mode="aspectFit"
				class="w-full h-full"
				@tap="toggleFullscreen"
				:show-menu-by-longpress="true"
			></image>
		</view>

		<!-- 加载中 -->
		<view class="wallpaper-container flex items-center justify-center" v-else>
			<cl-loading></cl-loading>
		</view>

		<!-- 底部操作栏 -->
		<cl-footer v-if="!isFullscreen">
			<view class="flex flex-col">
				<!-- 操作按钮 -->
				<view class="flex flex-row p-3">
					<cl-button
						type="primary"
						:pt="{ className: 'flex-1 mr-2' }"
						icon="download-line"
						:loading="downloading"
						@tap="downloadWallpaper"
					>下载</cl-button>
					<cl-button
						type="info"
						text
						:pt="{ className: 'flex-1' }"
						:icon="detailVisible ? 'arrow-up-s-line' : 'arrow-down-s-line'"
						@tap="toggleDetail"
					>详情</cl-button>
				</view>

				<!-- 折叠详情区域 -->
				<cl-collapse v-model="detailVisible">
					<view class="px-3 pb-3" v-if="wallpaper">
						<cl-list>
							<cl-list-item label="分辨率">
								<cl-text>{{ wallpaper.resolution }}</cl-text>
							</cl-list-item>
							<cl-list-item label="分类">
								<cl-tag size="small">{{ getCategoryLabel(wallpaper.category) }}</cl-tag>
							</cl-list-item>
							<cl-list-item label="内容分级">
								<cl-tag
									size="small"
									:type="getPurityType(wallpaper.purity)"
								>{{ getPurityLabel(wallpaper.purity) }}</cl-tag>
							</cl-list-item>
							<cl-list-item label="浏览量">
								<cl-text>{{ wallpaper.views }}</cl-text>
							</cl-list-item>
							<cl-list-item label="收藏数">
								<cl-text>{{ wallpaper.favorites }}</cl-text>
							</cl-list-item>
							<cl-list-item label="文件大小">
								<cl-text>{{ formatFileSize(wallpaper.file_size) }}</cl-text>
							</cl-list-item>
							<cl-list-item label="文件类型">
								<cl-text>{{ wallpaper.file_type }}</cl-text>
							</cl-list-item>
							<cl-list-item v-if="wallpaper.uploader" label="上传者">
								<cl-text>{{ wallpaper.uploader.username }}</cl-text>
							</cl-list-item>
							<cl-list-item label="上传时间">
								<cl-text>{{ wallpaper.created_at }}</cl-text>
							</cl-list-item>
						</cl-list>

						<!-- 标签 -->
						<view class="mt-3" v-if="wallpaper.tags && wallpaper.tags.length > 0">
							<cl-text :pt="{ className: 'text-sm text-surface-500 mb-2' }">标签</cl-text>
							<view class="flex flex-row flex-wrap">
								<cl-tag
									v-for="tag in wallpaper.tags"
									:key="tag.id"
									size="small"
									:pt="{ className: 'mr-2 mb-2' }"
								>{{ tag.name }}</cl-tag>
							</view>
						</view>

						<!-- 颜色 -->
						<view class="mt-3" v-if="wallpaper.colors && wallpaper.colors.length > 0">
							<cl-text :pt="{ className: 'text-sm text-surface-500 mb-2' }">主要颜色</cl-text>
							<view class="flex flex-row flex-wrap">
								<view
									v-for="(color, index) in wallpaper.colors"
									:key="index"
									class="w-8 h-8 rounded-lg mr-2 mb-2 border border-surface-200"
									:style="{ backgroundColor: color }"
								></view>
							</view>
						</view>
					</view>
				</cl-collapse>
			</view>
		</cl-footer>
	</cl-page>
</template>

<script lang="ts" setup>
import { ref, computed, onMounted } from "vue";
import { useStore } from "@/cool";
import { useUi } from "@/uni_modules/cool-ui";
import type { Wallpaper } from "@/types/wallhaven";

const ui = useUi();
const { wallhaven } = useStore();

// 壁纸数据
const wallpaper = ref<Wallpaper | null>(null);

// 壁纸ID
const wallpaperId = ref("");

// 详情折叠状态
const detailVisible = ref(false);

// 全屏模式
const isFullscreen = ref(false);

// 下载中
const downloading = ref(false);

// 是否已收藏
const isFavorite = computed(() => {
	return wallhaven.isFavorite(wallpaperId.value);
});

// 切换详情显示
function toggleDetail() {
	detailVisible.value = !detailVisible.value;
}

// 切换全屏
function toggleFullscreen() {
	isFullscreen.value = !isFullscreen.value;
}

// 切换收藏
function toggleFavorite() {
	if (isFavorite.value) {
		wallhaven.removeFavorite(wallpaperId.value);
		ui.showToast({ message: "已取消收藏" });
	} else {
		wallhaven.addFavorite(wallpaperId.value);
		ui.showToast({ message: "已收藏", icon: "heart-fill" });
	}
}

// 下载壁纸
async function downloadWallpaper() {
	if (!wallpaper.value) return;

	downloading.value = true;

	try {
		// 下载图片
		const downloadResult = await new Promise<UniApp.DownloadSuccessData>((resolve, reject) => {
			uni.downloadFile({
				url: wallpaper.value!.path,
				success: resolve,
				fail: reject
			});
		});

		// 保存到相册
		await new Promise<void>((resolve, reject) => {
			uni.saveImageToPhotosAlbum({
				filePath: downloadResult.tempFilePath,
				success: () => resolve(),
				fail: reject
			});
		});

		ui.showToast({
			message: "已保存到相册",
			icon: "check-line"
		});
	} catch (err: any) {
		ui.showToast({
			message: err.errMsg || "下载失败"
		});
	} finally {
		downloading.value = false;
	}
}

// 获取分类标签
function getCategoryLabel(category: string): string {
	const map: Record<string, string> = {
		general: "综合",
		anime: "动漫",
		people: "人物"
	};
	return map[category] || category;
}

// 获取纯度标签
function getPurityLabel(purity: string): string {
	const map: Record<string, string> = {
		sfw: "安全",
		sketchy: "轻微",
		nsfw: "成人"
	};
	return map[purity] || purity;
}

// 获取纯度类型（用于标签颜色）
function getPurityType(purity: string): string {
	const map: Record<string, string> = {
		sfw: "success",
		sketchy: "warning",
		nsfw: "error"
	};
	return map[purity] || "info";
}

// 格式化文件大小
function formatFileSize(bytes: number): string {
	if (bytes < 1024) return bytes + " B";
	if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
	return (bytes / (1024 * 1024)).toFixed(1) + " MB";
}

// 加载壁纸详情
async function loadWallpaper() {
	try {
		wallpaper.value = await wallhaven.getWallpaper(wallpaperId.value);
	} catch (err: any) {
		ui.showToast({
			message: err.message || "加载失败"
		});
	}
}

// 页面加载
onLoad((options: any) => {
	if (options.id) {
		wallpaperId.value = options.id;
		loadWallpaper();
	}
});
</script>

<style lang="scss" scoped>
.wallpaper-container {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: #000;
	display: flex;
	align-items: center;
	justify-content: center;
}
</style>
