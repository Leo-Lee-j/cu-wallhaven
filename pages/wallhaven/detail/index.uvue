<template>
	<cl-page background-color="#000">
		<!-- 顶部导航栏 -->
		<cl-topbar fixed safe-area-top :show-back="true" background-color="transparent" :pt="{
			className: '!z-50',
			back: {
				className: 'text-white bg-black/30 rounded-full ml-2'
			}
		}">
			<template #append>
				<view class="h-9 w-9 rounded-full flex flex-row items-center justify-center bg-black/30 mr-2"
					@tap="toggleFavorite">
					<cl-icon :name="isFavorite ? 'heart-fill' : 'heart-line'" :color="isFavorite ? '#ef4444' : 'white'"
						:size="40"></cl-icon>
				</view>
			</template>
		</cl-topbar>

		<!-- 壁纸显示区域 -->
		<view class="wallpaper-container">
			<!-- 加载动画 -->
			<view class="absolute top-0 left-0 right-0 bottom-0 flex items-center justify-center bg-black z-10"
				v-if="isLoading">
				<cl-loading :size="50" color="white"></cl-loading>
			</view>

			<!-- 图片 -->
			<!-- 图片区域 Swiper -->
			<swiper class="w-full h-full" :current="currentIndex" @change="onSwiperChange" :indicator-dots="false"
				:duration="300" v-if="isReady">
				<swiper-item v-for="(item, index) in wallpaperList" :key="item?.getString('id') ?? index">
					<view class="w-full h-full flex items-center justify-center bg-black relative">
						<cl-image :src="item?.getString('path') ?? ''" mode="aspectFit" width="100%" height="100%"
							:show-loading="false" :preview="false" :pt="{ inner: { className: '!rounded-none' } }"
							class="w-full h-full" @load="onImageLoad(item?.getString('id') ?? '')"
							@tap="onPreviewWallpaper">
						</cl-image>

						<!-- 自定义加载遮罩 -->
						<view
							class="absolute top-0 left-0 right-0 bottom-0 bg-black flex items-center justify-center transition-opacity duration-300 pointer-events-none"
							:class="loadedMap.has(item?.getString('id') ?? '') ? 'opacity-0' : 'opacity-100'">
							<cl-loading :size="40" color="#ffffff"></cl-loading>
						</view>
					</view>
				</swiper-item>
			</swiper>
		</view>

		<!-- 底部操作栏 - 毛玻璃效果 -->
		<view class="detail-footer" :class="{ 'footer-visible': imageLoaded }">
			<!-- 使用 cl-collapse 实现折叠效果 -->
			<cl-collapse v-model="detailVisible">
				<!-- 折叠详情区域（可滚动） -->
				<scroll-view direction="vertical" class="detail-scroll" v-if="wallpaper">
					<view class="px-4 pt-4 pb-4">
						<cl-list>
							<cl-list-item :label="t('分辨率')">
								<cl-text>{{ wallpaper?.getString('resolution') ?? '' }}</cl-text>
							</cl-list-item>
							<cl-list-item :label="t('分类')">
								<cl-tag size="small">{{ getCategoryLabel(wallpaper?.getString('category') ?? '')
								}}</cl-tag>
							</cl-list-item>
							<cl-list-item :label="t('内容分级')">
								<cl-tag size="small" :type="getPurityType(wallpaper?.getString('purity') ?? '')">{{
									getPurityLabel(wallpaper?.getString('purity') ?? '') }}</cl-tag>
							</cl-list-item>
							<cl-list-item :label="t('浏览量')">
								<cl-text>{{ wallpaper?.getNumber('views') ?? 0 }}</cl-text>
							</cl-list-item>
							<cl-list-item :label="t('收藏数')">
								<cl-text>{{ wallpaper?.getNumber('favorites') ?? 0 }}</cl-text>
							</cl-list-item>
							<cl-list-item :label="t('文件大小')">
								<cl-text>{{ formatFileSize(wallpaper?.getNumber('file_size') ?? 0) }}</cl-text>
							</cl-list-item>
							<cl-list-item :label="t('文件类型')">
								<cl-text>{{ wallpaper?.getString('file_type') ?? '' }}</cl-text>
							</cl-list-item>
							<cl-list-item v-if="wallpaper?.['uploader']" :label="t('上传者')">
								<cl-text>{{ (wallpaper?.['uploader'] as UTSJSONObject)?.getString('username') ?? ''
								}}</cl-text>
							</cl-list-item>
							<cl-list-item :label="t('上传时间')">
								<cl-text>{{ wallpaper?.getString('created_at') ?? '' }}</cl-text>
							</cl-list-item>
						</cl-list>

						<!-- 标签 -->
						<view class="mt-3"
							v-if="wallpaper?.['tags'] != null && ((wallpaper?.['tags'] as any[])?.length ?? 0) > 0">
							<cl-text :pt="{ className: 'text-sm text-white/60 mb-2' }">{{ t('标签') }}</cl-text>
							<view class="flex flex-row flex-wrap">
								<cl-tag v-for="tag in (wallpaper?.['tags'] as any[])"
									:key="(tag as UTSJSONObject).getNumber('id') ?? 0" size="small"
									:pt="{ className: 'mr-2 mb-2' }">{{ (tag as UTSJSONObject).getString('name') ?? ''
									}}</cl-tag>
							</view>
						</view>

						<!-- 颜色 -->
						<view class="mt-3"
							v-if="wallpaper?.['colors'] != null && ((wallpaper?.['colors'] as string[])?.length ?? 0) > 0">
							<cl-text :pt="{ className: 'text-sm text-white/60 mb-2' }">{{ t('主要颜色') }}</cl-text>
							<view class="flex flex-row flex-wrap">
								<view v-for="(color, index) in (wallpaper?.['colors'] as string[])" :key="index"
									class="w-8 h-8 rounded-lg mr-2 mb-2 border border-white/20"
									:style="{ backgroundColor: color }"></view>
							</view>
						</view>
					</view>
				</scroll-view>
			</cl-collapse>

			<!-- 操作按钮（图片加载完成后显示） -->
			<view class="action-buttons">
				<view class="flex-1 h-[88rpx] rounded-xl bg-white/20 flex flex-row items-center justify-center"
					@tap="downloadWallpaper">
					<cl-loading v-if="downloading" :size="32" color="white"></cl-loading>
					<template v-else>
						<cl-icon name="download-line" :size="36" color="white"></cl-icon>
						<cl-text :pt="{ className: 'text-white ml-2' }">{{ t('下载') }}</cl-text>
					</template>
				</view>
				<view class="flex-1 h-[88rpx] rounded-xl bg-white/20 flex flex-row items-center justify-center ml-3"
					@tap="toggleDetail">
					<cl-icon :name="detailVisible ? 'arrow-down-s-line' : 'arrow-up-s-line'" :size="36"
						color="white"></cl-icon>
					<cl-text :pt="{ className: 'text-white ml-2' }">{{ detailVisible ? t('收起') : t('详情') }}</cl-text>
				</view>
			</view>

			<cl-safe-area type="bottom"></cl-safe-area>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { ref, computed, onMounted } from "vue";
import { useStore } from "@/cool";
import { useUi } from "@/uni_modules/cool-ui";
import { t } from "@/locale";
import type { Wallpaper } from "@/types/wallhaven";

const ui = useUi();
const { wallhaven } = useStore();

// 壁纸数据
const wallpaper = ref<UTSJSONObject | null>(null);

// 壁纸ID
const wallpaperId = ref("");

// 记录加载完成的图片ID
const loadedMap = ref(new Set<string>());

// 图片是否加载完成
const imageLoaded = computed((): boolean => {
	return loadedMap.value.has(wallpaperId.value);
});

// loading状态
const isLoading = ref(true);

// 详情折叠状态
const detailVisible = ref(false);



// 下载中
const downloading = ref(false);

// 是否已收藏
const isFavorite = computed(() => {
	return wallhaven.isFavorite(wallpaperId.value);
});

// 切换详情显示
function toggleDetail() {
	detailVisible.value = !detailVisible.value;
}



// 切换收藏
function toggleFavorite() {
	if (isFavorite.value) {
		wallhaven.removeFavorite(wallpaperId.value);
		ui.showToast({ message: t("已取消收藏") });
	} else {
		wallhaven.addFavorite(wallpaperId.value);
		ui.showToast({ message: t("已收藏"), icon: "heart-fill" });
	}
}

// 壁纸列表
const wallpaperList = ref<UTSJSONObject[]>([]);
// 当前索引
const currentIndex = ref(0);

// 图片加载完成
function onImageLoad(id: string) {
	loadedMap.value.add(id);
}

// 切换 Swiper
function onSwiperChange(e: UniSwiperChangeEvent) {
	const current = e.detail.current;
	currentIndex.value = current;
	if (wallpaperList.value.length > current) {
		wallpaper.value = wallpaperList.value[current];
		wallpaperId.value = wallpaper.value?.getString('id') ?? '';
	}
}

// 定义下载错误类型
type DownloadError = {
	errMsg: string
}

// 下载壁纸
async function downloadWallpaper() {
	if (wallpaper.value === null) return;

	downloading.value = true;

	try {
		// 下载图片
		const tempFilePath = await new Promise<string>((resolve, reject) => {
			uni.downloadFile({
				url: wallpaper.value?.getString('path') ?? '',
				success: (res) => {
					// 直接访问res对象的属性，无需类型转换
					resolve(res.tempFilePath);
				},
				fail: (err) => reject(err)
			});
		});

		// 保存到相册
		await new Promise<void>((resolve, reject) => {
			uni.saveImageToPhotosAlbum({
				filePath: tempFilePath,
				success: () => resolve(),
				fail: reject
			});
		});

		ui.showToast({
			message: t("已保存到相册"),
			icon: "check-line"
		});
	} catch (err: any) {
		const error = err as DownloadError
		ui.showToast({
			message: error.errMsg ?? t("下载失败")
		});
	} finally {
		downloading.value = false;
	}
}

// 获取分类标签
function getCategoryLabel(category: string): string {
	switch (category) {
		case "general":
			return t("综合");
		case "anime":
			return t("动漫");
		case "people":
			return t("人物");
		default:
			return category;
	}
}

// 获取纯度标签
function getPurityLabel(purity: string): string {
	switch (purity) {
		case "sfw":
			return t("安全");
		case "sketchy":
			return t("轻微");
		case "nsfw":
			return t("成人");
		default:
			return purity;
	}
}

// 获取纯度类型（用于标签颜色）
function getPurityType(purity: string): any {
	switch (purity) {
		case "sfw":
			return "success";
		case "sketchy":
			return "warning";
		case "nsfw":
			return "error";
		default:
			return "info";
	}
}

// 格式化文件大小
function formatFileSize(bytes: number): string {
	if (bytes < 1024) return bytes + " B";
	if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
	return (bytes / (1024 * 1024)).toFixed(1) + " MB";
}

// Swiper是否准备就绪
const isReady = ref(false);

// 加载壁纸详情
async function loadWallpaper() {
	// 检查缓存
	const cache = wallhaven.currentWallpaper.value;

	// 初始化列表
	const storeList = wallhaven.wallpapers.value;
	if (storeList.length > 0) {
		// 查找当前索引
		const index = storeList.findIndex((w) => w.getString('id') === wallpaperId.value);
		if (index > -1) {
			currentIndex.value = index;
			wallpaperList.value = storeList;
			// 即使有列表，也优先使用 cache 或 storeList 中的对象更新当前 wallpaper
			wallpaper.value = storeList[index];
			console.log(`[detail] 从列表加载，索引: ${index}`);
			isLoading.value = false;
			isReady.value = true;
			return;
		} else {
			wallpaperList.value = storeList;
			currentIndex.value = 0;
			isReady.value = true;
		}
	} else {
		// 如果没有列表缓存（如直接进入），初始化包含单个的列表
		if (cache != null && cache?.getString("id") === wallpaperId.value) {
			wallpaper.value = cache;
			wallpaperList.value = [cache];
			currentIndex.value = 0;
			isLoading.value = false;
			isReady.value = true;
			return;
		}
	}

	// 如果没有缓存或列表中没找到，尝试通过网络加载
	if (cache != null && cache?.getString("id") === wallpaperId.value) {
		console.log(`[detail] 使用缓存壁纸: ${wallpaperId.value}`);
		wallpaper.value = cache;
		if (wallpaperList.value.length === 0) {
			currentIndex.value = 0;
			wallpaperList.value = [cache];
		}
		isLoading.value = false;
		isReady.value = true;
		return;
	}

	try {
		console.log(`[detail] 正在请求壁纸详情: ${wallpaperId.value}`);
		const result = await wallhaven.getWallpaper(wallpaperId.value);
		console.log(`[detail] 请求成功:`, result);
		const wp = result as UTSJSONObject;
		wallpaper.value = wp;
		if (wallpaperList.value.length === 0) {
			wallpaperList.value = [wp];
			currentIndex.value = 0; // 单张默认0
		}
		isReady.value = true;
	} catch (err: any) {
		console.error(`[detail] 请求失败:`, err);
		ui.showToast({
			message: err.message ?? t("加载失败")
		});
	} finally {
		isLoading.value = false;
		// 确保即使失败也显示（可能空白或错误提示），或者至少不让swiper报错?
		// 如果失败，wallpaperList可能为空。
		if (wallpaperList.value.length > 0) isReady.value = true;
	}
}

// 页面加载
onLoad((options?: UTSJSONObject) => {
	console.log("[detail] onLoad options:", options);
	if (options == null) return;
	const id = options?.["id"] as string | null;
	console.log("[detail] 解析到的 id:", id);
	if (id != null && id !== '') {
		wallpaperId.value = id;
		loadWallpaper();
	} else {
		console.error("[detail] 未获取到有效 id");
	}
});

// 预览壁纸（查看大图）
function onPreviewWallpaper() {
	if (wallpaper.value == null) return;
	const currentPath = wallpaper.value?.getString('path') ?? '';
	if (currentPath === '') return;

	uni.previewImage({
		urls: [currentPath],
		current: 0,
		indicator: "none"
	});
}
</script>

<style lang="scss" scoped>
.wallpaper-container {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: #000;
	display: flex;
	align-items: center;
	justify-content: center;
}

.detail-footer {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 40;
	background: rgba(0, 0, 0, 0.85);
	//backdrop-filter: blur(20px);
	border-radius: 32rpx 32rpx 0 0;
	max-height: 500px;
	display: flex;
	flex-direction: column;

	// 默认隐藏状态：向下偏移且透明
	opacity: 0;
	transform: translateY(20px);
	transition: opacity 0.4s ease-out, transform 0.4s ease-out;

	// 显示状态：完全显示并移动到原位
	&.footer-visible {
		opacity: 1;
		transform: translateY(0);
	}

	// 详情列表项白色文字
	:deep(.cl-list-item__label) {
		color: rgba(255, 255, 255, 0.6) !important;
	}

	:deep(.cl-text) {
		color: white !important;
	}

	:deep(.cl-list-item__wrapper) {
		background: transparent !important;
	}
}

.detail-wrapper {
	// uniappx 中不使用高度限制，让 collapse 组件自动计算
}

.detail-scroll {
	// uniappx 需要明确的固定高度（rpx 单位）而不是百分比
	height: 800rpx;
}

.action-buttons {
	display: flex;
	flex-direction: row;
	padding: 16rpx 32rpx;
}
</style>
