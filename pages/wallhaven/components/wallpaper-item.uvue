<template>
	<view class="wallpaper-item bg-white dark:!bg-surface-800 rounded-xl overflow-hidden mb-3"
		:class="{ 'is-visible': visible }" @tap="click">
		<image :src="getThumbnail(item)" mode="widthFix" class="w-full" :lazy-load="true"></image>

		<view class="p-2 flex flex-row items-center justify-between">
			<cl-tag size="small" type="info" :plain="true">
				{{ getResolution(item) }}
			</cl-tag>

			<view class="flex flex-row items-center px-2 py-1 -mr-2" @tap.stop="toggleFavorite">
				<cl-icon :name="isFavorited ? 'heart-fill' : 'heart-line'" :size="32"
					:color="isFavorited ? '#ef4444' : 'gray'"></cl-icon>
				<cl-text :pt="{ className: 'text-sm text-surface-400 ml-1' }">
					{{ getFavorites(item) }}
				</cl-text>
			</view>
		</view>

		<!-- 删除按钮 -->
		<view v-if="showDelete"
			class="absolute top-2 right-2 h-7 w-7 rounded-full bg-black/50 flex items-center justify-center z-10"
			@tap.stop="onDelete">
			<cl-icon name="heart-fill" :size="28" color="#ef4444"></cl-icon>
		</view>
	</view>
</template>

<script lang="ts" setup>
import { ref, watchEffect, onMounted } from "vue";

// 动画可见性控制
const visible = ref(false);

onMounted(() => {
	// 延时一小段时间后设置可见，触发 transition
	setTimeout(() => {
		visible.value = true;
	}, 50);
});

const props = defineProps({
	item: {
		type: Object,
		default: () => ({})
	},
	showDelete: {
		type: Boolean,
		default: false
	},
	// 是否已收藏
	favorited: {
		type: Boolean,
		default: false
	}
});

const emit = defineEmits(["tap", "delete", "favorite"]);

// 收藏状态
const isFavorited = ref(props.favorited);

// 监听props变化
watchEffect(() => {
	isFavorited.value = props.favorited;
});

// 点击事件
function click() {
	emit("tap", props.item);
}

// 删除事件
function onDelete() {
	emit("delete", props.item);
}

// 切换收藏
function toggleFavorite() {
	isFavorited.value = !isFavorited.value;

	// 获取壁纸ID
	const obj = props.item as UTSJSONObject;
	const id = obj.getString('id') ?? '';

	emit('favorite', {
		id,
		favorited: isFavorited.value
	});
}

// 辅助函数:获取缩略图 URL
function getThumbnail(item: any): string {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		const thumbs = obj['thumbs'] as UTSJSONObject | null;
		if (thumbs != null) {
			return thumbs.getString('original') ?? "";
		}
	}
	return "";
}

// 辅助函数:获取分辨率
function getResolution(item: any): string {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		return obj.getString('resolution') ?? "";
	}
	return "";
}

// 辅助函数:获取收藏数
function getFavorites(item: any): string {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		const num = obj.getNumber('favorites');
		return num != null ? num.toString() : "0";
	}
	return "0";
}
</script>

<style scoped>
.wallpaper-item {
	opacity: 0;
	transform: scale(0.9);
	transition-property: opacity, transform;
	transition-duration: 0.4s;
	transition-timing-function: ease-out;
}

.is-visible {
	opacity: 1;
	transform: scale(1);
}
</style>
