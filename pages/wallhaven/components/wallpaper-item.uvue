<template>
	<view
		class="wallpaper-item bg-white dark:bg-gray-800 overflow-hidden shadow-sm border border-gray-200 dark:border-gray-700"
		:class="{ 'is-visible': visible }" @tap="click">
		<view class="relative">
			<image :src="getThumbnail(item)" mode="widthFix" class="w-full" :lazy-load="true"></image>

			<!-- 收藏按钮 (右上角) -->
			<view
				class="absolute top-2 right-2 h-8 w-8 rounded-full bg-black/30 backdrop-blur-sm flex items-center justify-center z-10"
				@tap.stop="toggleFavorite">
				<cl-icon :name="isFavorited ? 'heart-fill' : 'heart-line'" :size="36"
					:color="isFavorited ? '#ef4444' : '#ffffff'"></cl-icon>
			</view>

			<!-- 分辨率 (左下角) -->
			<view
				class="absolute bottom-2 left-2 px-2 py-1 rounded bg-black/30 backdrop-blur-sm flex items-center justify-center pointer-events-none">
				<text class="text-xs text-white font-medium">{{ getResolution(item) }}</text>
			</view>

			<!-- 删除按钮 (仅当 showDelete 为 true 时显示，原有逻辑) -->
			<view v-if="showDelete"
				class="absolute top-2 left-2 h-7 w-7 rounded-full bg-black/50 flex items-center justify-center z-10"
				@tap.stop="onDelete">
				<cl-icon name="close-line" :size="28" color="#ffffff"></cl-icon>
			</view>
		</view>
	</view>
</template>

<script lang="ts" setup>
import { ref, watchEffect, onMounted } from "vue";

// 动画可见性控制
const visible = ref(false);

onMounted(() => {
	// 延时一小段时间后设置可见，触发 transition
	setTimeout(() => {
		visible.value = true;
	}, 50);
});

const props = defineProps({
	item: {
		type: Object,
		default: () => ({})
	},
	showDelete: {
		type: Boolean,
		default: false
	},
	// 是否已收藏
	favorited: {
		type: Boolean,
		default: false
	}
});

const emit = defineEmits(["tap", "delete", "favorite"]);

// 收藏状态
const isFavorited = ref(props.favorited);

// 监听props变化
watchEffect(() => {
	isFavorited.value = props.favorited;
});

// 点击事件
function click() {
	emit("tap", props.item);
}

// 删除事件
function onDelete() {
	emit("delete", props.item);
}

// 切换收藏
function toggleFavorite() {
	isFavorited.value = !isFavorited.value;

	// 获取壁纸ID
	const obj = props.item as UTSJSONObject;
	const id = obj.getString('id') ?? '';

	emit('favorite', {
		id,
		favorited: isFavorited.value
	});
}

// 辅助函数:获取缩略图 URL
function getThumbnail(item: any): string {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		const thumbs = obj['thumbs'] as UTSJSONObject | null;
		if (thumbs != null) {
			return thumbs.getString('original') ?? "";
		}
	}
	return "";
}

// 辅助函数:获取分辨率
function getResolution(item: any): string {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		return obj.getString('resolution') ?? "";
	}
	return "";
}


</script>

<style scoped>
.wallpaper-item {
	opacity: 0;
	transform: scale(0.9);
	transition-property: opacity, transform;
	transition-duration: 0.4s;
	transition-timing-function: ease-out;
}

.is-visible {
	opacity: 1;
	transform: scale(1);
}
</style>
