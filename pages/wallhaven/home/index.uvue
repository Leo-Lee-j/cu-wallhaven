				>
					<cl-icon name="filter-line" :size="40"></cl-icon>
				</view>
			</view>
		</cl-topbar>

		<!-- 搜索历史页面（带过渡动画） -->
		<view v-show="showSearchHistory" class="search-history-container">
			<view class="p-4">
				<!-- 有搜索历史 -->
				<view v-if="hasSearchHistory">
