											]),
											label: { className: 'text-xs' }
										}"
									></cl-radio>
								</cl-col>
							</cl-row>
						</cl-form-item>

						<!-- 壁纸类型 -->
						<cl-form-item label="壁纸类型">
							<cl-row :gutter="16">
								<cl-col :span="8">
									<cl-radio
										v-model="filterForm.wallpaperType"
										label="全部"
										value="all"
										:show-icon="false"
										:pt="{
									className: parseClass([
										'mb-3 p-2 rounded-lg justify-center border border-solid border-transparent',
										[isDark, 'bg-surface-800', 'bg-surface-100'],
										[
											filterForm.wallpaperType == 'all',
											`${isDark ? '!bg-surface-700' : '!bg-white'} !border-primary-500`
										]
									]),
									label: { className: 'text-sm' }
								}"
									></cl-radio>
								</cl-col>
								<cl-col :span="8">
									<cl-radio
										v-model="filterForm.wallpaperType"
										label="PC壁纸"
										value="pc"
										:show-icon="false"
										:pt="{
									className: parseClass([
										'mb-3 p-2 rounded-lg justify-center border border-solid border-transparent',
										[isDark, 'bg-surface-800', 'bg-surface-100'],
										[
											filterForm.wallpaperType == 'pc',
											`${isDark ? '!bg-surface-700' : '!bg-white'} !border-primary-500`
										]
									]),
									label: { className: 'text-sm' }
								}"
									></cl-radio>
								</cl-col>
								<cl-col :span="8">
									<cl-radio
										v-model="filterForm.wallpaperType"
										label="手机壁纸"
										value="mobile"
										:show-icon="false"
										:pt="{
									className: parseClass([
										'mb-3 p-2 rounded-lg justify-center border border-solid border-transparent',
										[isDark, 'bg-surface-800', 'bg-surface-100'],
										[
											filterForm.wallpaperType == 'mobile',
											`${isDark ? '!bg-surface-700' : '!bg-white'} !border-primary-500`
										]
									]),
									label: { className: 'text-sm' }
								}"
									></cl-radio>
								</cl-col>
							</cl-row>
						</cl-form-item>

						<!-- 颜色筛选 -->
						<cl-form-item label="颜色筛选">
							<cl-row :gutter="12">
								<cl-col :span="4" v-for="color in colorOptions" :key="color.value">
									<view
										class="color-item mb-3 rounded-lg border-2 border-solid"
										:class="[
									filterForm.colors.includes(color.value) ? 'border-primary-500' : 'border-transparent'
								]"
										@tap="toggleColor(color.value)"
									>
										<view
											class="color-box w-full h-10 rounded-md"
											:style="`background-color: #${color.value}`"
										></view>
									</view>
