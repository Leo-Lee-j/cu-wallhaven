												]
											]),
											label: { className: 'text-sm' }
										}"
									></cl-checkbox>
								</cl-col>
								<cl-col :span="8">
									<cl-checkbox
										v-model="filterForm.purity"
										label="Sketchy"
										value="sketchy"
										:show-icon="false"
										:pt="{
											className: parseClass([
												'mb-3 p-2 rounded-lg justify-center border border-solid border-transparent',
												[isDark, 'bg-surface-800', 'bg-surface-100'],
												[
													filterForm.purity.includes('sketchy'),
													`${isDark ? '!bg-surface-700' : '!bg-white'} !border-primary-500`
												]
											]),
											label: { className: 'text-sm' }
										}"
									></cl-checkbox>
								</cl-col>
								<cl-col :span="8">
									<cl-checkbox
										v-model="filterForm.purity"
										label="NSFW"
										value="nsfw"
										:show-icon="false"
										:pt="{
											className: parseClass([
												'mb-3 p-2 rounded-lg justify-center border border-solid border-transparent',
												[isDark, 'bg-surface-800', 'bg-surface-100'],
												[
													filterForm.purity.includes('nsfw'),
													`${isDark ? '!bg-surface-700' : '!bg-white'} !border-primary-500`
