				<cl-safe-area type="bottom"></cl-safe-area>
			</view>
		</cl-popup>
	</cl-page>
</template>

<script lang="ts" setup>
import { ref, reactive, computed, onMounted } from "vue";
import { router, useStore, isDark, parseClass } from "@/cool";
import { useUi } from "@/uni_modules/cool-ui";
import type { Wallpaper, FilterForm, SearchParams } from "@/types/wallhaven";

type OptionItem = {
	label: string;
	value: string;
};

const ui = useUi();
const { wallhaven } = useStore();
const store = wallhaven;

// 瀑布流引用
const waterfallRef = ref<ClWaterfallComponentPublicInstance | null>(null);

// 搜索关键词
const searchKeyword = ref("");

// 搜索历史显示
const showSearchHistory = ref(false);

// 是否有搜索历史
const hasSearchHistory = computed<boolean>((): boolean => {
	return store.searchHistory.value.length >= 1;
});

// 左侧抽屉
const leftDrawerVisible = ref(false);

// 右侧抽屉
const rightDrawerVisible = ref(false);

// 加载状态
const loading = ref(false);
const finished = ref(false);

// 当前页码
let currentPage = 1;

// 随机种子（用于 random 排序时保持分页一致性）
let randomSeed: string | null = null;

// 筛选表单(本地副本)- 使用默认值初始化
const filterForm = reactive<FilterForm>({
	categories: ["general", "anime", "people"],
	purity: ["sfw"],
	sorting: "date_added",
	topRange: "1M",
	ratios: [] as string[],
	wallpaperType: "all",
	colors: [] as string[]
});

// 从 store 同步筛选表单数据
function syncFilterFormFromStore() {
	const storeForm = store.filterForm.value;
	if (storeForm != null) {
		if (storeForm.categories != null && Array.isArray(storeForm.categories)) {
			filterForm.categories = [...storeForm.categories];
		}
		if (storeForm.purity != null && Array.isArray(storeForm.purity)) {
			filterForm.purity = [...storeForm.purity];
		}
		if (storeForm.sorting != null) {
			filterForm.sorting = storeForm.sorting;
		}
		if (storeForm.topRange != null) {
			filterForm.topRange = storeForm.topRange;
		}
		if (storeForm.ratios != null && Array.isArray(storeForm.ratios)) {
			filterForm.ratios = [...storeForm.ratios];
		}
		if (storeForm.wallpaperType != null) {
			filterForm.wallpaperType = storeForm.wallpaperType;
		}
		if (storeForm.colors != null && Array.isArray(storeForm.colors)) {
			filterForm.colors = [...storeForm.colors];
		}
	}
}

// 排序选项
const sortingOptions = ref<OptionItem[]>([
	{ label: "最新", value: "date_added" },
	{ label: "热门", value: "toplist" },
	{ label: "随机", value: "random" },
	{ label: "浏览", value: "views" }
]);

// 热门时间范围选项
const topRangeOptions = ref<OptionItem[]>([
	{ label: "1天", value: "1d" },
	{ label: "3天", value: "3d" },
	{ label: "1周", value: "1w" },
	{ label: "1月", value: "1M" },
	{ label: "3月", value: "3M" },
	{ label: "6月", value: "6M" },
	{ label: "1年", value: "1y" }
]);

// 宽高比选项
const ratioOptions = ref<OptionItem[]>([
	{ label: "16x9", value: "16x9" },
	{ label: "16x10", value: "16x10" },
	{ label: "21x9", value: "21x9" },
	{ label: "32x9", value: "32x9" },
	{ label: "9x16", value: "9x16" },
	{ label: "10x16", value: "10x16" }
]);

// 颜色选项 - 来自 Wallhaven API 文档的24种预设颜色
type ColorOption = {
	value: string;
}
const colorOptions = ref<ColorOption[]>([
	{ value: "660000" },
	{ value: "990000" },
	{ value: "cc0000" },
	{ value: "cc3333" },
	{ value: "ea4c88" },
	{ value: "993399" },
	{ value: "663399" },
	{ value: "333399" },
	{ value: "0066cc" },
	{ value: "0099cc" },
	{ value: "66cccc" },
	{ value: "77cc33" },
	{ value: "669900" },
	{ value: "336600" },
	{ value: "666600" },
	{ value: "999900" },
	{ value: "cccc33" },
	{ value: "ffff00" },
	{ value: "ffcc33" },
	{ value: "ff9900" },
	{ value: "ff6600" },
	{ value: "cc6633" },
	{ value: "996633" },
	{ value: "663300" }
]);

// 加载数据
async function loadData() {
	if (loading.value || finished.value) return;

	loading.value = true;

	try {
		console.log("开始请求数据，参数:", {
			q: searchKeyword.value !== "" ? searchKeyword.value : null,
			page: currentPage,
			seed: randomSeed
		});

		const response = await store.search({
			q: searchKeyword.value !== "" ? searchKeyword.value : null,
			page: currentPage,
			seed: randomSeed
		} as any);

		console.log("请求成功，返回数据:", response);

		// 将 response 转换为 UTSJSONObject 以访问属性
		const jsonResponse = response as UTSJSONObject;
		const wallpapers = jsonResponse['data'] as any[];

		if (wallpapers.length === 0) {
			console.log("返回数据为空");
			finished.value = true;
		} else {
			console.log(`获取到 ${wallpapers.length} 条数据，准备追加到瀑布流`);
			
			if (waterfallRef.value == null) {
				console.error("waterfallRef 为空，无法追加数据！");
			} else {
				// @ts-ignore
				waterfallRef.value?.append(wallpapers as UTSJSONObject[]);
			}

			// 保存随机种子
			const meta = jsonResponse['meta'] as UTSJSONObject;
			if (meta != null) {
				const seed = meta.getString('seed');
				if (seed != null) {
					randomSeed = seed;
				}
			}

			// 检查是否最后一页
			if (meta != null) {
				const lastPage = meta.getNumber('last_page') ?? 1;
				if (currentPage >= lastPage) {
					finished.value = true;
				} else {
					currentPage++;
				}
			}
		}
	} catch (err: any) {
		console.error("请求数据出错:", err);
		ui.showToast({
			message: err.message ?? "加载失败"
		});
	} finally {
		loading.value = false;
	}
}

// 刷新列表
async function refreshList() {
	currentPage = 1;
	randomSeed = "";
	finished.value = false;
	waterfallRef.value?.clear();
	await loadData();
}

// 打开左侧抽屉
function openLeftDrawer() {
	leftDrawerVisible.value = true;
}

// 打开右侧抽屉
function openRightDrawer() {
	rightDrawerVisible.value = true;
}

// 搜索框聚焦 - 进入搜索模式
function onSearchFocus() {
	showSearchHistory.value = true;
}

// 取消搜索 - 退出搜索模式
function cancelSearch() {
	showSearchHistory.value = false;
	searchKeyword.value = "";
}

// 搜索
function onSearch() {
	if (searchKeyword.value.trim().length > 0) {
		store.addSearchHistory(searchKeyword.value.trim());
	}
	showSearchHistory.value = false;
	refreshList();
}

// 点击搜索历史
function onHistoryClick(keyword: string) {
	searchKeyword.value = keyword;
	showSearchHistory.value = false;
	refreshList();
}

// 移除单条历史
function removeHistory(keyword: string) {
	store.removeSearchHistory(keyword);
}

// 清空搜索历史
function clearSearchHistory() {
	store.clearSearchHistory();
	showSearchHistory.value = false;
}

// 切换颜色选择
function toggleColor(colorValue: string) {
	const index = filterForm.colors.indexOf(colorValue);
	if (index >= 0) {
		filterForm.colors.splice(index, 1);
	} else {
		filterForm.colors.push(colorValue);
	}
}

// 重置筛选
function resetFilter() {
	filterForm.categories = ["general", "anime", "people"];
	filterForm.purity = ["sfw"];
	filterForm.sorting = "date_added";
	filterForm.topRange = "1M";
	filterForm.ratios = [];
	filterForm.wallpaperType = "all";
	filterForm.colors = [];
}

// 应用筛选
function applyFilter() {
	store.setFilterForm({
		categories: [...filterForm.categories],
		purity: [...filterForm.purity],
		sorting: filterForm.sorting,
		topRange: filterForm.topRange,
		ratios: [...filterForm.ratios],
		wallpaperType: filterForm.wallpaperType,
		colors: [...filterForm.colors]
	});
	rightDrawerVisible.value = false;
	refreshList();
}

// 辅助函数:获取缩略图 URL
function getThumbnail(item: any): string {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		const thumbs = obj['thumbs'] as UTSJSONObject | null;
		if (thumbs != null) {
			return thumbs.getString('original') ?? "";
		}
	}
	return "";
}

// 辅助函数:获取分辨率
function getResolution(item: any): string {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		return obj.getString('resolution') ?? "";
	}
	return "";
}

// 辅助函数:获取收藏数
function getFavorites(item: any): string {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		const num = obj.getNumber('favorites');
		return num != null ? num.toString() : "0";
	}
	return "0";
}



// 跳转到详情页
function toDetail(item: UTSJSONObject) {
	router?.to(`/pages/wallhaven/detail/index?id=${item.getString("id") ?? ""}`);
}

// 跳转到在线收藏夹
function toCollections() {
	leftDrawerVisible.value = false;
	router?.to("/pages/wallhaven/collections/index");
}

// 跳转到本地收藏
function toFavorites() {
	leftDrawerVisible.value = false;
	router?.to("/pages/wallhaven/favorites/index");
}

// 跳转到设置
function toSettings() {
	leftDrawerVisible.value = false;
	router?.to("/pages/wallhaven/settings/index");
}

// 跳转到关于
function toAbout() {
	leftDrawerVisible.value = false;
	router?.to("/pages/wallhaven/about/index");
}

// 触底加载更多
onReachBottom(() => {
	loadData();
});

// 初始化
onMounted(() => {
	syncFilterFormFromStore();
	refreshList();
});
</script>

