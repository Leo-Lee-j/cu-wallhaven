/* uvue 不支持 @keyframes 动画，已移除 */

.history-tag {
	transition: all 0.2s ease;

	&:active {
		transform: scale(0.95);
		opacity: 0.8;
	}
}

// 覆盖抽屉高度，使其撑满屏幕
:deep(.cl-popup-wrapper--left),
:deep(.cl-popup-wrapper--right) {
	.cl-popup {
		height: 100% !important;
	}
}

// 抽屉头部渐变背景
.drawer-header {
	background-color: #6366f1;
	background-image: linear-gradient(to bottom right, #6366f1, #8b5cf6, #a855f7);
}
</style>
