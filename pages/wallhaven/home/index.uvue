				<!-- 底部按钮 -->
				<view class="flex flex-row p-3 border-t border-surface-100 dark:!border-surface-700">
					<cl-button
						type="info"
						text
						:pt="{ className: 'flex-1 mr-2' }"
						@tap="resetFilter"
					>重置
					</cl-button>
					<cl-button
						:pt="{ className: 'flex-1' }"
						@tap="applyFilter"
					>确定
					</cl-button>
