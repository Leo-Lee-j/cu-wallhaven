<template>
	<cl-page
		:back-top="true"
	>
		<!-- 顶部导航栏 -->
		<cl-topbar
			fixed
			:show-back="false"
			safe-area-top
			:pt="{
				className: '!z-50'
			}"
		>
			<view class="flex flex-row items-center p-3 flex-1 w-full">
				<!-- 左侧菜单按钮（搜索模式下隐藏） -->
				<view
					v-if="!showSearchHistory"
					class="h-9 w-9 rounded-full flex flex-row items-center justify-center bg-surface-100 dark:!bg-surface-700"
					@tap="openLeftDrawer"
				>
					<cl-icon name="menu-line" :size="40"></cl-icon>
				</view>

				<!-- 中间搜索框 -->
				<view class="flex-1 mx-3" @tap="onSearchFocus">
					<cl-input
						v-model="searchKeyword"
						placeholder="搜索壁纸..."
						prefix-icon="search-line"
						clearable
						:pt="{
							className: 'rounded-full'
						}"
						@confirm="onSearch"
					></cl-input>
				</view>

				<!-- 右侧按钮：搜索模式下显示取消，正常模式显示刷新和筛选 -->
				<view v-if="showSearchHistory">
					<cl-text
						:pt="{ className: 'text-primary-500' }"
						@tap="cancelSearch"
					>取消
					</cl-text>
				</view>
				<view v-else class="flex flex-row items-center">
					<!-- 刷新按钮 -->
					<view
						class="h-9 w-9 rounded-full flex flex-row items-center justify-center bg-surface-100 dark:!bg-surface-700 mr-2"
						@tap="onRefreshClick"
					>
						<cl-icon name="refresh-line" :size="40"></cl-icon>
					</view>
					<!-- 筛选按钮 -->
					<view
						class="h-9 w-9 rounded-full flex flex-row items-center justify-center bg-surface-100 dark:!bg-surface-700"
						@tap="openRightDrawer"
					>
						<cl-icon name="filter-line" :size="40"></cl-icon>
					</view>
				</view>
			</view>
		</cl-topbar>

		<!-- 搜索历史组件 -->
		<search-history
			:visible="showSearchHistory"
			@search="onHistorySearch"
			@close="showSearchHistory = false"
		></search-history>

		<!-- 壁纸列表（带过渡动画） -->
		<view v-show="!showSearchHistory" class="wallpaper-container p-2">
			<cl-waterfall ref="waterfallRef" :column="2" :gutter="12">
				<template #item="{ item }">
					<wallpaper-item
						:item="item"
						:favorited="isFavorited(item)"
						@tap="toDetail(item)"
						@favorite="onFavorite"
					></wallpaper-item>
				</template>
			</cl-waterfall>

			<!-- 空状态提示 -->
			<view v-if="isEmpty && !loading" class="empty-state flex flex-col items-center justify-center py-20">
				<cl-icon name="image-line" :size="120" :pt="{ className: 'text-surface-300 dark:!text-surface-600' }"></cl-icon>
				<cl-text :pt="{ className: 'mt-4 text-surface-400 dark:!text-surface-500' }">暂无搜索结果</cl-text>
				<cl-text :pt="{ className: 'mt-2 text-sm text-surface-300 dark:!text-surface-600' }">换个关键词或调整筛选条件试试</cl-text>
			</view>

			<view class="h-12 flex flex-row items-center justify-center w-full">
				<cl-loadmore v-if="!isEmpty" :loading="loading" :finished="finished"></cl-loadmore>
			</view>
		</view>

		<!-- 左侧抽屉菜单组件 -->
		<menu-drawer v-model:visible="leftDrawerVisible"></menu-drawer>

		<!-- 右侧筛选抽屉组件 -->
		<filter-drawer
			v-model:visible="rightDrawerVisible"
			@confirm="refreshList"
		></filter-drawer>
	</cl-page>
</template>

<script lang="ts" setup>
import { ref, onMounted } from "vue";
import { router, useStore } from "@/cool";
import { useUi } from "@/uni_modules/cool-ui";
import type { Wallpaper } from "@/types/wallhaven";
import WallpaperItem from "../components/wallpaper-item.uvue";
import FilterDrawer from "./components/FilterDrawer.uvue";
import MenuDrawer from "./components/MenuDrawer.uvue";
import SearchHistory from "./components/SearchHistory.uvue";

const ui = useUi();
const { wallhaven } = useStore();
const store = wallhaven;

// 瀑布流引用
const waterfallRef = ref<ClWaterfallComponentPublicInstance | null>(null);

// 搜索关键词
const searchKeyword = ref("");

// 搜索历史显示
const showSearchHistory = ref(false);

// 左侧抽屉
const leftDrawerVisible = ref(false);

// 右侧抽屉
const rightDrawerVisible = ref(false);

// 加载状态
const loading = ref(false);
const finished = ref(false);
const isEmpty = ref(false); // 无数据状态

// 当前页码
let currentPage = 1;

// 随机种子（用于 random 排序时保持分页一致性）
let randomSeed: string | null = null;

// 加载数据
async function loadData() {
	if (loading.value || finished.value) return;

	loading.value = true;

	try {
		console.log("开始请求数据，参数:", {
			q: searchKeyword.value !== "" ? searchKeyword.value : null,
			page: currentPage,
			seed: randomSeed
		});

		const response = await store.search({
			q: searchKeyword.value !== "" ? searchKeyword.value : null,
			page: currentPage,
			seed: randomSeed
		} as any);

		console.log("请求成功，返回数据:", response);

		// 将 response 转换为 UTSJSONObject 以访问属性
		const jsonResponse = response as UTSJSONObject;
		const wallpapers = jsonResponse['data'] as any[];

		if (wallpapers.length === 0) {
			console.log("返回数据为空");
			finished.value = true;
			// 第一页就没有数据，设置空状态
			if (currentPage === 1) {
				isEmpty.value = true;
			}
		} else {
			console.log(`获取到 ${wallpapers.length} 条数据，准备追加到瀑布流`);

			if (waterfallRef.value == null) {
				console.error("waterfallRef 为空，无法追加数据！");
			} else {
				// @ts-ignore
				waterfallRef.value?.append(wallpapers as UTSJSONObject[]);
			}

			// 保存随机种子
			const meta = jsonResponse['meta'] as UTSJSONObject | null;
			if (meta != null) {
				const seed = meta?.getString('seed');
				if (seed != null) {
					randomSeed = seed;
				}
			}

			// 检查是否最后一页
			if (meta != null) {
				const lastPage = meta?.getNumber('last_page') ?? 1;
				if (currentPage >= lastPage) {
					finished.value = true;
				} else {
					currentPage++;
				}
			}
		}
	} catch (err: any) {
		console.error("请求数据出错:", err);
		ui.showToast({
			message: err.message ?? "加载失败"
		});
	} finally {
		// 延迟结束加载，等待瀑布流渲染完成
		setTimeout(() => {
			loading.value = false;
		}, 200);
	}
}

// 刷新列表
async function refreshList() {
	currentPage = 1;
	randomSeed = "";
	finished.value = false;
	isEmpty.value = false; // 重置空状态
	waterfallRef.value?.clear();
	await loadData();
}

// 打开左侧抽屉
function openLeftDrawer() {
	leftDrawerVisible.value = true;
}

// 打开右侧抽屉
function openRightDrawer() {
	rightDrawerVisible.value = true;
}

// 点击刷新按钮
function onRefreshClick() {
	refreshList();
}

// 搜索框聚焦 - 进入搜索模式
function onSearchFocus() {
	showSearchHistory.value = true;
}

// 取消搜索 - 退出搜索模式
function cancelSearch() {
	showSearchHistory.value = false;
	searchKeyword.value = "";
}

// 搜索
function onSearch() {
	if (searchKeyword.value.trim().length > 0) {
		store.addSearchHistory(searchKeyword.value.trim());
	}
	showSearchHistory.value = false;
	refreshList();
}

// 历史记录搜索
function onHistorySearch(keyword: string) {
	searchKeyword.value = keyword;
	showSearchHistory.value = false;
	refreshList();
}

// 跳转详情页
function toDetail(item: any) {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		const id = obj?.getString("id");
		if (id != null) {
			router?.to(`/pages/wallhaven/detail/index?id=${id}`);
		}
	}
}

// 判断是否收藏
function isFavorited(item: any): boolean {
	const obj = item as UTSJSONObject | null;
	if (obj != null) {
		const id = obj?.getString("id");
		if (id != null) {
			return store.isFavorite(id);
		}
	}
	return false;
}

// 处理收藏事件
function onFavorite(item: any) {
	const obj = item as UTSJSONObject | null;
	if (obj == null) return;

	const id = obj?.getString("id");

	if (id != null) {
		if (store.isFavorite(id)) {
			store.removeFavorite(id);
			ui.showToast({ message: '已取消收藏' });
		} else {
			// 直接使用从 UTSJSONObject 中获取的 id
			store.addFavorite(id);
			ui.showToast({ message: '已添加到收藏' });
		}
	}
}

// 下拉刷新
onPullDownRefresh(() => {
	// 重置分页
	currentPage = 1;
	randomSeed = "";
	finished.value = false;
	// 清空瀑布流
	waterfallRef.value?.clear();

	loadData().then(() => {
		uni.stopPullDownRefresh();
	});
});

// 初始化
onMounted(() => {
	// 确保 store 数据已从本地存储加载（应用重启后需要重新加载）
	store.load();
	refreshList();
});
</script>
