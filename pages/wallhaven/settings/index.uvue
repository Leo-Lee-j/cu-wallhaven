<template>
	<cl-page>
		<view class="p-3">
			<cl-form
				:pt="{ className: 'p-2 pb-0' }"
				v-model="formData"
				ref="formRef"
				label-position="top"
			>
				<cl-form-item label="API Key" prop="apiKey">
					<cl-input
						v-model="formData.apiKey"
						placeholder="请输入 Wallhaven API Key"
						password
						clearable
					></cl-input>
					<cl-text :pt="{ className: 'text-xs text-surface-400 mt-1' }">
						在 wallhaven.cc 账户设置中获取 API Key，用于查看 NSFW 内容和个人收藏夹
					</cl-text>
				</cl-form-item>

				<cl-form-item label="用户名" prop="username">
					<cl-input
						v-model="formData.username"
						placeholder="请输入 Wallhaven 用户名"
						clearable
					></cl-input>
					<cl-text :pt="{ className: 'text-xs text-surface-400 mt-1' }">
						用于查看在线收藏夹
					</cl-text>
				</cl-form-item>
			</cl-form>
		</view>

		<cl-footer>
			<view class="flex flex-row p-3">
				<cl-button
					type="primary"
					size="large"
					:pt="{ className: 'flex-1 !rounded-xl h-[80rpx]' }"
					:loading="saving"
					@tap="save"
				>保存</cl-button>
			</view>
		</cl-footer>
	</cl-page>
</template>

<script lang="ts" setup>
import { ref, onMounted } from "vue";
import { useStore } from "@/cool";
import { useUi } from "@/uni_modules/cool-ui";

const ui = useUi();
const { wallhaven } = useStore();

// 表单数据
const formData = ref({
	apiKey: "",
	username: ""
});

// 保存中
const saving = ref(false);

// 保存设置
async function save() {
	saving.value = true;

	try {
		wallhaven.setApiKey(formData.value.apiKey);
		wallhaven.setUsername(formData.value.username);

		ui.showToast({
			message: "保存成功",
			icon: "check-line"
		});

		// 返回上一页
		setTimeout(() => {
			uni.navigateBack();
		}, 500);
	} catch (err: any) {
		ui.showToast({
			message: err.message || "保存失败"
		});
	} finally {
		saving.value = false;
	}
}

// 初始化
onMounted(() => {
	formData.value.apiKey = wallhaven.apiKey.value;
	formData.value.username = wallhaven.username.value;
});
</script>
