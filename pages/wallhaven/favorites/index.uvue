<template>
	<cl-page :back-top="true">
		<!-- 加载中状态 -->
		<view class="flex flex-col items-center justify-center h-[450px]" v-if="loading && favorites.length === 0">
			<cl-loading :size="80"></cl-loading>
			<cl-text :pt="{ className: 'text-surface-400 mt-4' }">{{ t('正在加载收藏...') }}</cl-text>
		</view>

		<!-- 有数据状态 -->
		<view v-else-if="favorites.length > 0">
			<cl-waterfall ref="waterfallRef" :column="2" :gutter="0">
				<template #item="{ item }">
					<wallpaper-item :item="item" :show-delete="true" @tap="toDetail(item)"
						@delete="removeFavorite(item)"></wallpaper-item>
				</template>
			</cl-waterfall>

			<cl-loadmore :loading="loading" :finished="true" safe-area-bottom></cl-loadmore>
		</view>

		<!-- 空状态 -->
		<view class="flex flex-col items-center justify-center h-[450px]" v-else>
			<cl-icon name="heart-line" :size="120" color="gray"></cl-icon>
			<cl-text :pt="{ className: 'text-surface-400 mt-4' }">{{ t('暂无收藏') }}</cl-text>
			<cl-text :pt="{ className: 'text-surface-300 text-sm mt-2' }">{{ t('浏览壁纸时点击心形图标添加收藏') }}</cl-text>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { ref, nextTick, onShow } from "vue";
import { router, useStore } from "@/cool";
import { useUi } from "@/uni_modules/cool-ui";
import { t } from "@/locale";
import WallpaperItem from "../components/wallpaper-item.uvue";

const ui = useUi();
const { wallhaven } = useStore();

// 瀑布流引用
const waterfallRef = ref<ClWaterfallComponentPublicInstance | null>(null);

// 收藏列表
const favorites = ref<UTSJSONObject[]>([]);

// 加载状态
const loading = ref(false);


// 加载收藏的壁纸详情
async function loadFavorites() {
	const ids = wallhaven.localFavorites.value;

	if (ids.length === 0) {
		favorites.value = [];
		return;
	}

	loading.value = true;

	try {
		const wallpapers: UTSJSONObject[] = [];

		for (const id of ids) {
			try {
				const wpData = await wallhaven.getWallpaper(id);
				// 直接使用 UTSJSONObject
				const obj = wpData as UTSJSONObject;
				// 确保有 thumbs 字段，防止空指针
				if (obj['thumbs'] == null) {
					obj['thumbs'] = {} as UTSJSONObject;
				}
				wallpapers.push(obj);
			} catch (err) {
				// 忽略单个加载失败
				console.error(`Failed to load wallpaper ${id}`, err);
			}
		}

		favorites.value = wallpapers;

		// 使用 nextTick 确保 v-if 条件变化后瀑布流组件渲染完成
		await nextTick();
		waterfallRef.value?.clear();

		if (wallpapers.length > 0) {
			// @ts-ignore
			waterfallRef.value?.append(wallpapers);
		}
	} catch (err: any) {
		ui.showToast({
			message: err.message ?? t("加载失败")
		});
	} finally {
		loading.value = false;
	}
}

// 跳转到详情页
function toDetail(item: any) {
	const obj = item as UTSJSONObject;
	router.to(`/pages/wallhaven/detail/index?id=${obj.getString('id')}`);
}

// 取消收藏
function removeFavorite(item: any) {
	const obj = item as UTSJSONObject;
	const id = obj.getString('id') ?? "";

	ui.showConfirm({
		title: t("提示"),
		message: t("确定取消收藏吗？"),
		callback(action) {
			if (action === "confirm") {
				wallhaven.removeFavorite(id);

				// 从列表中移除
				const index = favorites.value.findIndex((w) => w.getString('id') === id);
				if (index > -1) {
					favorites.value.splice(index, 1);
					waterfallRef.value?.remove(id);
				}

				ui.showToast({ message: t("已取消收藏") });
			}
		}
	});
}

// 初始化
onShow(() => {
	loadFavorites();
});
</script>
