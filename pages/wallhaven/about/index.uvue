<script lang="ts" setup>
// 打开 Wallhaven 官网
function openWallhaven() {
	// UTS 环境暂不支持直接打开浏览器,复制链接到剪贴板
	uni.setClipboardData({
		data: "https://wallhaven.cc",
		showToast: false,
		success: () => {
			uni.showToast({
				title: "链接已复制",
				icon: "success"
			});
		}
	});
}
</script>
