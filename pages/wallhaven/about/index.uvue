<script lang="ts" setup>
// 打开 Wallhaven 官网
function openWallhaven() {
	// #ifdef H5
	window.open("https://wallhaven.cc", "_blank");
	// #endif

	// #ifdef APP-PLUS
	plus.runtime.openURL("https://wallhaven.cc");
	// #endif

	// #ifdef MP
	uni.setClipboardData({
		data: "https://wallhaven.cc",
		success: () => {
			uni.showToast({
				title: "链接已复制",
				icon: "success"
			});
		}
	});
	// #endif
}
</script>
