			<!-- 外部链接 -->
			<cl-list :pt="{ className: 'w-full mt-4' }">
				<cl-list-item
					label="访问 Wallhaven"
					icon="external-link-line"
					arrow
					hoverable
					@tap="openWallhaven"
				></cl-list-item>
			</cl-list>
		</view>
	</cl-page>
